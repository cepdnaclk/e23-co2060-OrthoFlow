DATABASE_URL="postgresql://postgres:your-password@localhost:5432/orthoflow?schema=public"
JWT_SECRET="change-this-secret"

# Email reminder settings. Without these, reminders are logged to the console.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-clinic-email@example.com"
SMTP_PASS="your-app-password"
MAIL_FROM="OrthoRecords <your-clinic-email@example.com>"

# Appointment reminders are sent once when an appointment is within this window.
REMINDER_ADVANCE_HOURS="24"
REMINDER_SCAN_INTERVAL_MINUTES="5"

# Production hosting (Render supplies these; local development can leave them unset).
# NODE_ENV=production
# DATA_DIR=/var/data
# ADMIN_USERNAME=your-admin-name
# ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters
# CORS_ORIGINS=https://your-separate-frontend.example.com
# Set false to disable automatic reminders during local tests.
REMINDERS_ENABLED=true
