generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int             @id @default(autoincrement())
  username      String          @unique
  password      String
  role          String          @default("STAFF")
  fullName      String?
  email         String?
  regNumber     String?
  createdAt     DateTime        @default(now())
  patientAccess PatientAccess[]
  notifications Notification[]
}

model Patient {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId      String        @unique
  name           String
  initials       String?
  status         String        @default("Assessment")
  dob            DateTime?
  gender         String?
  phone          String?
  email          String?
  address        String?
  chiefComplaint String?
  medicalHistory String?
  dentalHistory  String?
  allergies      String?
  referredBy     String?
  notes          String?
  guardian       String?
  guardianPhone  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
  historyLogs    HistoryLog[]
  radiographs    Radiograph[]
  patientAccess  PatientAccess[]
  notifications  Notification[]
}

model Appointment {
  id                       Int            @id @default(autoincrement())
  patientId                String         @db.Uuid
  date                     DateTime
  time                     String
  type                     String
  duration                 String
  status                   String
  createdAt                DateTime       @default(now())
  reminderDueAt            DateTime?
  patientReminderSentAt    DateTime?
  clinicianReminderSentAt  DateTime?
  reminderStatus           String         @default("Pending")
  reminderLastMessage      String?
  reminderLastAttemptAt    DateTime?
  patientEmailStatus       String         @default("Pending")
  patientSmsStatus         String         @default("Pending")
  patientNotificationStatus String        @default("Pending")
  clinicianEmailStatus     String         @default("Pending")
  clinicianNotificationStatus String      @default("Pending")
  patient                  Patient        @relation(fields: [patientId], references: [id])
  notifications            Notification[]
}

model Radiograph {
  id          Int      @id @default(autoincrement())
  patientId   String   @db.Uuid
  category    String   @default("RADIOGRAPH")
  fileUrl     String
  uploadDate  DateTime @default(now())
  description String?
  patient     Patient  @relation(fields: [patientId], references: [id])
}

model HistoryLog {
  id        Int      @id @default(autoincrement())
  patientId String   @db.Uuid
  action    String
  timestamp DateTime @default(now())
  details   String?
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model PatientAccess {
  id        Int      @id @default(autoincrement())
  userId    Int
  patientId String   @db.Uuid
  grantedBy Int      
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  @@unique([userId, patientId])
}

model Notification {
  id            Int          @id @default(autoincrement())
  userId        Int?
  patientId     String?      @db.Uuid
  appointmentId Int?
  recipientType String       @default("USER")
  type          String       @default("APPOINTMENT_REMINDER")
  title         String
  message       String
  read          Boolean      @default(false)
  createdAt     DateTime     @default(now())
  readAt        DateTime?

  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient       Patient?     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([patientId, read])
  @@index([appointmentId])
}
